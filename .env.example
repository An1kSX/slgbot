# Имя установки Docker Compose. После первого запуска не менять.
COMPOSE_PROJECT_NAME=slgbot

# Обязательно: Telegram (см. README.md)
API_ID=
API_HASH=
BOT_TOKEN=
# Необязательно: username бота без @
BOT_USERNAME=

# MySQL: задайте два разных пароля. Остальное можно оставить.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=slg_bot
MYSQL_PASSWORD=
MYSQL_DATABASE=slg_bot
MYSQL_QUEUE_SIZE=10

# Telegram ID пользователей, через запятую. Нужен минимум один суперадминистратор.
SUPERADMIN_IDS=
ADMIN_IDS=

# Классификация обращений. Без ключа все непустые сообщения считаются деловыми.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Сотрудники и расписание. Время всегда Asia/Tashkent.
STAFF_MARKER=SLG
STAFF_USERNAMES=
STAFF_USER_IDS=
WORKING_DAYS=0,1,2,3,4,5
WORK_START=09:00
WORK_END=18:00
APPEAL_REPORT_TIME=09:00
APPEAL_COOLDOWN_SECONDS=54000
APPEAL_AUTO_REPLY=Спасибо за обращение в SherLegal! Сейчас у нас нерабочее время. Мы получили ваше сообщение и ответим, как только вернёмся к работе.

# Логи и выгрузка. Пути хранения задаются в docker-compose.yml.
MAX_DOCUMENT_MB=50
LOG_ZIP_PREFIX=slg_chats
LOG_ARCHIVE_TIME=00:00
LOG_LEVEL=INFO
